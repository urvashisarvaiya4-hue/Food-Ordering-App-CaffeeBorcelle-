<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".fragment_search">

    <!-- Header -->
    <TextView
        android:id="@+id/SearchHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/SearchFrag1"
        android:textColor="@color/brownDark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="@font/song_myung"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/SearchSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/SearchFrag2"
        android:textColor="@color/brownDark"
        android:textSize="14sp"
        android:fontFamily="@font/bigshot_one"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/SearchHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardElevation="6dp"
        app:cardCornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/SearchSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/SearchView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:queryHint="Search for products..."
            android:iconifiedByDefault="false"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:iconifiedByDefault="false"
            android:fontFamily="@font/song_myung" />
    </androidx.cardview.widget.CardView>

    <!-- Results Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/ResultsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:background="@color/brownDark"
        android:backgroundTint="@color/brownLight"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/SearchRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                tools:listitem="@layout/activity_product_search" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/EmptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:src="@drawable/broken_image"
                    android:contentDescription="@string/SearchFragEmpty1"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/SearchFragEmpty2"
                    android:textColor="@color/brownDark"
                    android:textSize="16sp"
                    android:fontFamily="@font/song_myung"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/SearchFragEmpty3"
                    android:textColor="@color/brownDark"
                    android:textSize="14sp"
                    android:fontFamily="@font/song_myung"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>