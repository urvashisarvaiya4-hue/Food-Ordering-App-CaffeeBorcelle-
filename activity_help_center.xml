<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:background="@color/cafe_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help Center"
            android:fontFamily="@font/song_myung"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brownDark"
            android:layout_marginBottom="20dp"/>

        <!-- FAQ 1 -->
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:fontFamily="@font/song_myung"
            android:text="Q1: How can I place an order?"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="You can browse products, add them to cart and proceed to checkout."
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:layout_marginTop="4dp"/>

        <!-- FAQ 2 -->
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Q2: How can I track my order?"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Go to My Orders section to track your order status."
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:layout_marginTop="4dp"/>

        <!-- FAQ 3 -->
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Q3: How do I contact support?"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_height="wrap_content"
            android:fontFamily="@font/song_myung"
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:text="You can contact us via email or phone using the button below."
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <!-- Contact Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContactSupport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Contact Support"
            android:fontFamily="@font/song_myung"
            android:textAllCaps="false"
            android:layout_marginTop="30dp"
            android:textColor="@color/white"
            app:backgroundTint="@color/brownDark"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</ScrollView>