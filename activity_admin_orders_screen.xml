<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_admin_orders_screen">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/AdminOrders"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/brownDark"
        android:fontFamily="@font/bigshot_one"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"/>

    <!-- 🔥 FILTER BUTTONS -->
    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeader"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"/>

        <Button
            android:id="@+id/btnDispatched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dispatched"
            android:layout_marginStart="12dp"/>

        <Button
            android:id="@+id/btnCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutFilters"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        tools:listitem="@layout/activity_order_item_blueprint" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutFilters"
        android:text="@string/AdminOrdersEmpty"
        android:textSize="22sp"
        android:textStyle="italic"
        android:textColor="@color/brownDark"
        android:gravity="center"
        android:visibility="gone"/>

</RelativeLayout>