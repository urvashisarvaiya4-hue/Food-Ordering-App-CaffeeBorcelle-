<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:background="@android:color/white"
    android:foreground="?attr/selectableItemBackground"
    tools:context=".cart_items_blueprint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/cafe_bg"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/HomeItemImage"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/EditProductIMAGE"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/ProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ProductName"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/ProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ProductPrice"
                android:textSize="16sp"
                android:textColor="#FF5722"
                android:layout_marginTop="8dp"
                android:textStyle="bold"/>

            <!-- Quantity Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/minusbutton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/DecreaseQuantity"
                    android:src="@drawable/remove"
                    android:padding="4dp"
                    app:tint="@color/brownDark" />

                <TextView
                    android:id="@+id/cartItemQuantity"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Quantity"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    android:textColor="#212121"
                    android:padding="6dp" />

                <ImageButton
                    android:id="@+id/plusebutton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/IncreaseQuantity"
                    android:src="@drawable/plus_icon"
                    android:padding="4dp"
                    app:tint="@color/brownDark" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/CartItemDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/DeleteButton"
            android:src="@drawable/delete"
            android:padding="4dp"
            app:tint="@color/brownDark" />

    </LinearLayout>

</androidx.cardview.widget.CardView>