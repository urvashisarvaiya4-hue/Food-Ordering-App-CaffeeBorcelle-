<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CaffeeBorcelle" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">@color/brownDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/brownDark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & surface -->
        <item name="colorOnBackground">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/BrownButton</item>

    </style>

    <style name="Theme.CaffeeBorcelle" parent="Base.Theme.CaffeeBorcelle" />

    <!-- Custom button style -->
    <style name="BrownButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brownDark</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>