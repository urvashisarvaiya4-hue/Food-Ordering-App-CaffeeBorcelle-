<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_bg"
    tools:context=".detail_item_blueprint">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/BackBTN"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back_arrow"
            app:tint="@color/brownDark" />

        <!-- Product Name -->
        <!-- Product Name -->
        <TextView
            android:id="@+id/detailProductNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="@string/ProductName"
            android:textColor="@color/brownDark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/wishlistButton"
            app:layout_constraintTop_toBottomOf="@id/imageButton"
            style="@style/TextAppearance.MaterialComponents.Headline5" />

        <!-- Wishlist Icon -->
        <ImageButton
            android:id="@+id/wishlistButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/Wishlist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/detailProductNameTextView"
            app:srcCompat="@drawable/wishlist_icon"
            app:tint="@color/brownDark" />

        <!-- Product Image Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/productImageCardView"
            android:layout_width="0dp"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/brownDark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailProductNameTextView">

            <ImageView
                android:id="@+id/detailProductImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/EditProductIMAGE"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Price -->
        <TextView
            android:id="@+id/detailProductPriceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ProductPrice"
            android:textColor="@color/brownDark"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/productImageCardView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/dividerUnderPrice"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/brownDark"
            app:layout_constraintTop_toBottomOf="@id/detailProductPriceTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Short Description -->
        <TextView
            android:id="@+id/shortDescriptionTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ManagingProductOptionsADDShortDescription"
            android:textColor="@color/brownDark"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerUnderPrice" />

        <TextView
            android:id="@+id/shortDescriptionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ManagingProductOptionsADDShortDescription"
            android:textColor="@color/brownDark"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            app:layout_constraintStart_toStartOf="@id/shortDescriptionTitleTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shortDescriptionTitleTextView" />

        <!-- Full Description
        <TextView
            android:id="@+id/fullDescriptionTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ManagingProductOptionsADDFullDescription"
            android:textColor="@color/brownDark"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/shortDescriptionTitleTextView"
            app:layout_constraintTop_toBottomOf="@id/shortDescriptionTextView" />

        <TextView
            android:id="@+id/fullDescriptionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ManagingProductOptionsADDFullDescription"
            android:textColor="@color/brownDark"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            app:layout_constraintStart_toStartOf="@id/fullDescriptionTitleTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fullDescriptionTitleTextView" />

         Key Features
        <TextView
            android:id="@+id/keyFeaturesTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ManagingProductOptionsADDKeyFeatures"
            android:textColor="@color/brownDark"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/fullDescriptionTitleTextView"
            app:layout_constraintTop_toBottomOf="@id/fullDescriptionTextView" />

        <TextView
            android:id="@+id/keyFeaturesTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ManagingProductOptionsADDKeyFeatures"
            android:textColor="@color/brownDark"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            app:layout_constraintStart_toStartOf="@id/keyFeaturesTitleTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/keyFeaturesTitleTextView" />-->

        <!-- Add to Cart Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addToCartButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/AddToCart"
            android:fontFamily="@font/button"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="8dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/brownDark"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shortDescriptionTextView" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>