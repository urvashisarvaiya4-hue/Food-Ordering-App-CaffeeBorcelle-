<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="16dp"
    tools:context=".fragment_wishlist">

    <!-- RecyclerView with card-style items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wishlistRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:paddingTop="16dp"
        tools:listitem="@layout/activity_wishlist_items_blueprint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Neumorphic Empty State Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/emptyStateLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/cafe_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@drawable/shape_edittext">

            <!-- Animated icon placeholder (can use Lottie later) -->
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/broken_image"
                android:contentDescription="@string/WishlistFragEmpty1"
                android:alpha="0.5"
                android:translationY="-10dp"
                android:scaleType="centerInside"/>

            <!-- Empty state messages -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/WishlistFragEmpty2"
                android:fontFamily="@font/song_myung"
                android:textColor="@color/brownDark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/WishlistFragEmpty3"
                android:fontFamily="@font/song_myung"
                android:textColor="@color/brownDark"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textAlignment="center"/>

            <!-- CTA Button to Browse Products -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/browseProductsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/WishlistFragEmpty4"
                android:fontFamily="@font/button"
                android:layout_marginTop="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/brownDark"
                android:textColor="@color/brownDark"
                android:elevation="6dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>