<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_bg"
    tools:context=".activity_home_page">

    <!-- Rounded Transparent App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/ToolBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="16dp"
        android:stateListAnimator="@null"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:textColor="@color/brownDark"
            android:textSize="22sp"
            android:letterSpacing="0.05" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Main Navigation Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_activity_home_page"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/mobile_navigation"
        tools:layout="@layout/fragment_home"
        app:layout_constraintTop_toBottomOf="@id/ToolBar"
        app:layout_constraintBottom_toTopOf="@id/nav_view_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false" />

    <!-- Floating Glassmorphic Bottom Navigation -->
    <androidx.cardview.widget.CardView
        android:id="@+id/nav_view_container"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="24dp"
        android:background="@color/white"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="2dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:itemIconSize="23dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:itemIconTint="@color/brownDark"
            app:itemTextColor="@color/brownDark"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>