<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6D5C3"
tools:context=".activity_management_login">


    <!-- Top Dark Section -->
    <View
        android:id="@+id/topSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#3E2723"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/loginCard"
        app:layout_constraintHeight_percent="0.40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <ImageView
        android:id="@+id/AdminLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="64dp"
        app:tint="#FFFFFF"
        android:src="@drawable/manage_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/ManagementLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/calistoga"
        android:text="@string/ManagementLogin"
        android:tint="#FFFFFF"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AdminLogo" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Access"
        android:textSize="14sp"
        android:textColor="#E0CFC2"
        android:fontFamily="@font/song_myung"
        app:layout_constraintTop_toBottomOf="@id/ManagementLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Login Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:strokeColor="@color/brownDark"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/coffee_light_cream"
        android:padding="24dp">

    <!-- Username -->
    <EditText
        android:id="@+id/ManagementUsername"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Username"
        android:background="@drawable/glow_edittext"
        android:padding="15dp"
        android:textColor="#3E2723"
        android:textColorHint="#8D6E63"/>

    <!-- Space -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp"/>

    <!--com.google.android.material.textfield.TextInputLayout
        android:id="@+id/username_text_input_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:hint="@string/ManagementUserName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ManagementLogin"
        android:textColorHint="@color/brownDark"
        app:boxStrokeColor="@color/brownDark"
        app:hintTextColor="@color/brownDark">-->

        <!-- Password -->
        <EditText
            android:id="@+id/ManagementPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:background="@drawable/glow_edittext"
            android:padding="15dp"
            android:textColor="#3E2723"
            android:textColorHint="#8D6E63"/>

        <!-- Space -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

        <!-- Login Button -->
        <Button
            android:id="@+id/ManagementLoginButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="LOGIN"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="#3E2723"/>

    </LinearLayout>
    </androidx.cardview.widget.CardView>

