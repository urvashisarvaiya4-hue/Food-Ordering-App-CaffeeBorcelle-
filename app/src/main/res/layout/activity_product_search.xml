<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    tools:context=".product_search">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/cafe_bg"
        android:padding="12dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/productImageView"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/broken_image"
            android:background="@drawable/shape_edittext"
            android:contentDescription="@string/EditProductIMAGE"
            android:layout_marginEnd="12dp"
            android:clipToOutline="true" />

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Product Name -->
            <TextView
                android:id="@+id/productNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ProductName"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/brownDark"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Dynamic Rating -->
            <RatingBar
                android:id="@+id/productRatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:isIndicator="true"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_marginTop="2dp" />

            <!-- Price Row -->
            <TextView
                android:id="@+id/productPriceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ProductPrice"
                android:textSize="14sp"
                android:textColor="@color/brownDark"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Add to Cart Button -->
        <Button
            android:id="@+id/addToCartButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/AddBTN"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/brownDark"
            android:layout_gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>