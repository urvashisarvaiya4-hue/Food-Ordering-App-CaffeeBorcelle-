<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    tools:context=".fragment_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


    <!-- Banner / Image Slider -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="15dp">

        <com.denzcoskun.imageslider.ImageSlider
            android:id="@+id/ImageSlider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:iss_auto_cycle="true"
            app:iss_delay="2000"
            app:iss_period="2000"/>

    </androidx.cardview.widget.CardView>

        <!-- Categories Title -->
        <TextView
            android:id="@+id/txtCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:text="Categories"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:textColor="@color/brownDark"/>

        <!-- Categories RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="true"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtCategories"
            android:background="@android:color/transparent"
            tools:listitem="@layout/activity_item_category"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>

        <!-- Best Sellers Title -->
        <TextView
            android:id="@+id/BestSellers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fresh Food"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:gravity="center"
            android:fontFamily="@font/song_myung"
            android:textColor="@color/brownDark"/>

        <!-- Best Seller RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/BestSellerRecyclerView"
            android:layout_width="match_parent"
            android:layout_marginTop="15dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="12dp"
            android:clipToPadding="false"
            tools:listitem="@layout/activity_bestseller_items_blueprint" />

    </LinearLayout>


</androidx.core.widget.NestedScrollView>