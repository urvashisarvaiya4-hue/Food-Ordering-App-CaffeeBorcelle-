<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/cafe_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Rewards"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/song_myung"
            android:textColor="@color/brownDark"
            android:layout_marginBottom="20dp"/>

        <!-- Points Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Total Points"
                    android:fontFamily="@font/song_myung"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:id="@+id/txtPoints"
                    android:fontFamily="@font/song_myung"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/brownDark"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Reward Item 1 -->
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:fontFamily="@font/song_myung"
            android:text="🎁 Free Coffee at 300 Points"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <!-- Reward Item 2 -->
        <TextView
            android:layout_height="wrap_content"
            android:fontFamily="@font/song_myung"
            android:layout_width="wrap_content"
            android:text="🎁 20% Discount at 500 Points"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <!-- Reward Item 3 -->
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:fontFamily="@font/song_myung"
            android:text="🎁 Free Dessert at 700 Points"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

</ScrollView>