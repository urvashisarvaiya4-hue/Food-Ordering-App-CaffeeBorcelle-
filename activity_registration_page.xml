<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_bg"
tools:context=".activity_registration_page">

    <!-- TOP CURVE BG (same as login) -->
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:scaleType="centerCrop"
        android:src="@drawable/top_curve"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOGO -->

    <!-- TITLE -->
    <ImageView
        android:id="@+id/registerLogo"
        android:layout_width="247dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textRegisterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textColor="@color/cafe_dark"
        android:textStyle="bold"
        android:textSize="24sp"
        android:fontFamily="serif"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/registerLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CARD CONTAINER -->
    <LinearLayout
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:backgroundTint="@color/white"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/textRegisterTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- FULL NAME -->
        <EditText
            android:id="@+id/edtFullName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/glow_edittext"
            android:padding="12dp"
            android:drawableStart="@drawable/ic_email"
            android:hint="Full Name"
            android:textColor="@color/cafe_dark"
            android:textColorHint="#795548" />

        <!-- EMAIL -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/glow_edittext"
            android:padding="12dp"
            android:drawableStart="@drawable/ic_email"
            android:hint="Email"
            android:layout_marginTop="12dp"
            android:textColor="@color/cafe_dark"
            android:textColorHint="#795548" />

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/glow_edittext"
            android:padding="12dp"
            android:drawableStart="@drawable/ic_pass"
            android:hint="Password"
            android:inputType="textPassword"
            android:layout_marginTop="12dp"
            android:textColor="@color/cafe_dark"
            android:textColorHint="#795548" />

        <!-- CONFIRM PASSWORD -->
        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/glow_edittext"
            android:padding="12dp"
            android:drawableStart="@drawable/ic_pass"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:layout_marginTop="12dp"
            android:textColor="@color/cafe_dark"
            android:textColorHint="#795548" />

        <!-- REGISTER BUTTON -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Register"
            android:clickable="true"
            android:textColor="@android:color/white"
            android:background="@drawable/cafe_btn"
            android:layout_marginTop="20dp" />

        <!-- Already have an account? -->
        <TextView
            android:id="@+id/txtLoginRedirect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login"
            android:textColor="@color/cafe_dark"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_gravity="center" />

        <Button
            android:id="@+id/btnAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/btn_brown"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="serif"
            android:text="I am Admin"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteY="636dp" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>