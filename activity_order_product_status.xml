<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity_order_product_status">


    <TextView
        android:id="@+id/EmptyOrders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No orders found!"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="16dp"
        android:textColor="@color/brownDark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOrderStatusTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/OrderStatus"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/brownDark"
        android:gravity="center"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrderStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        tools:listitem="@layout/activity_order_product_status_blueprint"
        app:layout_constraintTop_toBottomOf="@id/tvOrderStatusTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>